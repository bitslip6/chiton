+static int ad903x_get_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_pad_config *cfg,
+			     struct v4l2_subdev_format *format)
+{
+	struct ad903x *ad903x = to_ad903x(sd);
+
+	dev_info(ad903x->dev, "get_fmt which %d\n", format->which);
+	format->format = *__ad903x_get_pad_format(ad903x, cfg, format->pad,
+						  format->which);
+	dev_info(ad903x->dev, "get_fmt: %x %dx%d\n",
+		format->format.code, format->format.width,
+		format->format.height);
+	return 0;
+}
