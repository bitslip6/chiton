+static int ad903x_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ad903x *ad903x = to_ad903x(sd);
+#if 0
+	if (ad903x->use_cci)
+		msm_cci_ctrl_release();
+#endif
+	v4l2_async_unregister_subdev(&ad903x->sd);
+	media_entity_cleanup(&ad903x->sd.entity);
+	v4l2_ctrl_handler_free(&ad903x->ctrls);
+	mutex_destroy(&ad903x->power_lock);
+
+	return 0;
+}
