+static int ad903x_s_stream(struct v4l2_subdev *subdev, int enable)
+{
+	struct ad903x *ad903x = to_ad903x(subdev);
+	int ret;
+
+	dev_info(ad903x->dev, "stream %d\n", enable);
+	if (enable) {
+		ret = ad903x_set_register_array(ad903x,
+					ad903x->current_mode->data,
+					ad903x->current_mode->data_size);
+		if (ret < 0) {
+			dev_err(ad903x->dev, "could not set mode %dx%d\n",
+				ad903x->current_mode->width,
+				ad903x->current_mode->height);
+			return ret;
+		}
+	} else {
+		
+	}
+	/*program AFE for streamon only*/
+	if(enable == 1)
+	{
+		printk("\nProgram AFE");
+        	ret = ad903x_programAfe(&ad903x->sd);
+	}
+	else /*power down the afe*/
+	{
+
+		ret = ad903x_s_power(&ad903x->sd, true);
+		if (ret < 0) 
+		{
+			dev_err(ad903x->dev, "could not power up AD903X\n");
+		}
+
+		ret = ad903x_s_power(&ad903x->sd, false);
+		if (ret < 0) 
+		{
+			dev_err(ad903x->dev, "could not power down AD903X\n");
+		}
+		else
+		{
+			printk("\npower down succeed");
+		}
+        }
+	return 0;
+}
