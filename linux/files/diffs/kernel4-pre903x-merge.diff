+static int ad903x_s_power(struct v4l2_subdev* sd, int on)
+{
+	struct ad903x *ad903x = to_ad903x(sd);
+	int ret = 0;
+
+	mutex_lock(&ad903x->power_lock);
+
+	dev_info(ad903x->dev, "s_power %d\n", on);
+	/* If the power count is modified from 0 to != 0 or from != 0 to 0,
+	 * update the power state.
+	 */
+	if (ad903x->power_count == !on) {
+		if (on) {
+			mutex_lock(&ad903x_lock);
+
+			ret = ad903x_set_power_on(ad903x);
+			if (ret < 0) {
+        			mutex_unlock(&ad903x_lock);
+				goto exit;
+			}  
+			
+      			mutex_unlock(&ad903x_lock);
+
+      			dev_info(ad903x->dev, "power on complete\n");
+    		} else {
+			mutex_lock(&ad903x_lock);
+
+			ret = ad903x_set_power_off(ad903x);
+			if (ret < 0) {
+        			mutex_unlock(&ad903x_lock);
+				goto exit;
+			}  
+			
+      			mutex_unlock(&ad903x_lock);
+
+      			dev_info(ad903x->dev, "power off complete\n");
+    		}      
+			
+	}
+
+	/* Update the power count. */
+	ad903x->power_count += on ? 1 : -1;
+	WARN_ON(ad903x->power_count < 0);
+
+exit:
+	mutex_unlock(&ad903x->power_lock);
+
+	return ret;
+}
