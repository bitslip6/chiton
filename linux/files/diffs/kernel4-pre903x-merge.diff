+static const struct ad903x_mode_info *
+ad903x_find_nearest_mode(unsigned int width, unsigned int height)
+{
+	unsigned int i;
+
+	for (i = ARRAY_SIZE(ad903x_mode_info_data) - 1; i >= 0; i--) {
+		if (ad903x_mode_info_data[i].width <= width &&
+		    ad903x_mode_info_data[i].height <= height)
+			break;
+	}
+
+	if (i < 0)
+		i = 0;
+
+	return &ad903x_mode_info_data[i];
+}
