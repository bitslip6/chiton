+};
+
+struct ad903x {
+	struct i2c_client *i2c_client;
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+//	struct v4l2_of_endpoint ep;
+	struct v4l2_fwnode_endpoint ep;
+	struct v4l2_mbus_framefmt fmt;
+	struct v4l2_rect crop;
+	struct clk *xclk;
+
+	const struct ad903x_mode_info *current_mode;
+
+	struct v4l2_ctrl_handler ctrls;
+
+	/* Cached register values */
+	u8 aec_pk_manual;
+	u8 timing_tc_reg20;
+	u8 timing_tc_reg21;
+
+	struct mutex power_lock; /* lock to protect power state */
+	int power_count;
+
+//	struct gpio_desc *rst_gpio;
+	int rst_gpio;
+
+	bool use_cci; /* indicate that CCI driver hack should be used */
+	struct v4l2_subdev *cci;
+	int csi;
+	u8 mclk_source;
+	u32 mclk;
+  /* controls */
+	struct v4l2_ctrl *set_chip_config;
+	struct v4l2_ctrl *reg_read;
+};
+
+static inline struct ad903x *to_ad903x(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ad903x, sd);
+}
