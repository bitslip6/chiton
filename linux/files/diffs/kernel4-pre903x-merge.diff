+static int ad903x_write_reg(struct ad903x* ad903x, u16 reg, u16* val)
+{
+	int ret;
+	u16 i2c_addr = ad903x->i2c_client->addr;
+#if 0
+	if (ad903x->use_cci)	{
+		/* perform i2c via qcom CCI interface */
+		ret = msm_cci_ctrl_write(i2c_addr, reg, (u8*)val, 1);
+	} else
+#endif
+ 	{
+		struct i2c_msg msg;
+		u8 data[4] =  {(reg & 0xff00) >> 8, reg & 0xff, (*val & 0xff00) >> 8, *val & 0xff};
+		msg.addr = i2c_addr;
+		msg.len = 4;
+		msg.buf = data;
+		msg.flags = 0;
+		ret = i2c_transfer(ad903x->i2c_client->adapter, &msg, 1);
+	}
+
+	if (ret < 0) {
+		dev_err(ad903x->dev,
+			"%s: write reg error %d on addr 0x%x: reg=0x%x, val=0x%x\n",
+			__func__, ret, i2c_addr, reg, *val);
+	}
+	
+	return ret;
+}
+
+static int ad903x_read_reg(struct ad903x* ad903x, u16 reg, u16* val)
+{
+	int ret;
+	u16 i2c_addr = ad903x->i2c_client->addr;
+	
+#if 0
+	if (ad903x->use_cci) {
+		/* perform i2c via qcom CCI interface */
+		ret = msm_cci_ctrl_read(i2c_addr, reg, (u8*)val, 2);
+    		*val = ((*val >> 8) | (*val << 8)); 
+		dev_info(ad903x->dev,
+			"read reg addr 0x%x: reg=0x%x\n", reg, *val);
+  	}  else
+#endif
+	{
+		struct i2c_msg msg[2];
+		u8 data[2] =  {(reg & 0xff00) >> 8, reg & 0xff};
+		msg[0].addr = i2c_addr;
+		msg[0].len =  2;
+		msg[0].buf = data;
+		msg[0].flags = 0;
+
+		msg[1].addr = i2c_addr;
+		msg[1].len = 2;
+		msg[1].buf = (u8 *)val;
+		msg[1].flags = I2C_M_RD;
+
+		ret = i2c_transfer(ad903x->i2c_client->adapter, msg, 2);
+	}
+
+	if (ret < 0) {
+		dev_err(ad903x->dev,
+			"%s: read reg error %d on addr 0x%x: reg=0x%x\n",
+			__func__, ret, i2c_addr, reg);
+		return ret;
+	}
+	*val = ((*val >> 8) | (*val << 8));
+	return 0;
+}
+
+static int ad903x_set_register_array(struct ad903x* ad903x,
+				     const struct ad903x_reg_value* settings,
+				     unsigned int num_settings)
+{
+	unsigned int i;
+	int ret;
+	u16 val;
+
+	for (i = 0; i < num_settings; ++i, ++settings) {
+    		val = settings->val;
+		ret = ad903x_write_reg(ad903x, settings->reg, &val);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
