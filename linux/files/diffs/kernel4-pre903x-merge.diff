+static int ad903x_entity_init_cfg(struct v4l2_subdev *subdev,
+				  struct v4l2_subdev_pad_config *cfg)
+{
+	struct v4l2_subdev_format fmt = { 0 };
+	struct ad903x *ad903x = to_ad903x(subdev);
+
+	dev_err(ad903x->dev, "%s: Enter\n", __func__);
+
+	fmt.which = cfg ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	fmt.format.width = 640;
+	fmt.format.height = 960;
+
+	ad903x_set_format(subdev, cfg, &fmt);
+
+	return 0;
+}
