+static int ad903x_set_power_on(struct ad903x* ad903x)
+{
+	int ret;
+
+	dev_info(ad903x->dev, "ad903x_set_power_on\n");
+
+	ret = clk_prepare_enable(ad903x->xclk);
+	if (ret < 0) {
+		dev_err(ad903x->dev, "clk prepare enable failed\n");
+		return ret;
+	}
+	printk("clk_prepare_enable \n");
+//	gpio_set_value_cansleep(ad903x->rst_gpio, 1);
+
+	printk("gpiod_set_value_cansleep \n");
+	ret = ad903x_set_register_array(ad903x,
+		ad903x_powerup_setting,
+		ARRAY_SIZE(ad903x_powerup_setting));
+    	if (ret < 0) {
+      		dev_err(ad903x->dev, "could not set power up registers\n");
+	}
+
+	printk("gpiod_set_value_cansleep 1\n");
+	return ret;
+}
+
+static int ad903x_set_power_off(struct ad903x* ad903x)
+{
+	int ret = 0;
+
+	dev_info(ad903x->dev, "ad903x_set_power_off\n");
+  	
+	ret = ad903x_set_register_array(ad903x,
+		ad903x_powerdown_setting,
+		ARRAY_SIZE(ad903x_powerdown_setting));
+    	if (ret < 0) {
+      		dev_err(ad903x->dev, "could not set power down registers\n");
+	}
+
+//	gpio_set_value_cansleep(ad903x->rst_gpio, 0);	
+	clk_disable_unprepare(ad903x->xclk);
+
+	return ret;
+}
