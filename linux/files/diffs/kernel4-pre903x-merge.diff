+static int ad903x_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_pad_config *cfg,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct ad903x *ad903x = to_ad903x(sd);
+	dev_info(ad903x->dev, "Mbus code index %d\n", code->index);
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR12_1X12;
+
+	return 0;
+}
+
+static int ad903x_enum_frame_size(struct v4l2_subdev *subdev,
+				  struct v4l2_subdev_pad_config *cfg,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct ad903x *ad903x = to_ad903x(subdev);
+	
+	dev_info(ad903x->dev, "Mbus fs code %d index %d\n", fse->code, fse->index);
+	
+	if (fse->code != MEDIA_BUS_FMT_SBGGR12_1X12)
+		return -EINVAL;
+
+	if (fse->index >= ARRAY_SIZE(ad903x_mode_info_data))
+		return -EINVAL;
+
+	fse->min_width = ad903x_mode_info_data[fse->index].width;
+	fse->max_width = ad903x_mode_info_data[fse->index].width;
+	fse->min_height = ad903x_mode_info_data[fse->index].height;
+	fse->max_height = ad903x_mode_info_data[fse->index].height;
+
+	return 0;
+}
