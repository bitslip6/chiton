+static struct v4l2_rect *
+__ad903x_get_pad_crop(struct ad903x *ad903x, struct v4l2_subdev_pad_config *cfg,
+		      unsigned int pad, enum v4l2_subdev_format_whence which)
+{
+	switch (which) {
+	case V4L2_SUBDEV_FORMAT_TRY:
+		return v4l2_subdev_get_try_crop(&ad903x->sd, cfg, pad);
+	case V4L2_SUBDEV_FORMAT_ACTIVE:
+		return &ad903x->crop;
+	default:
+		return NULL;
+	}
