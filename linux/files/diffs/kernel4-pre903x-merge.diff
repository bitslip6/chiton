+static int ad903x_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct ad903x *ad903x = to_ad903x(sd);
+	struct v4l2_subdev_pad_config cfg;
+	int ret;
+
+	dev_err(ad903x->dev, "%s: Enter\n", __func__);
+	memset(&cfg, 0, sizeof(cfg));
+
+	ret  = ad903x_entity_init_cfg(sd, &cfg);
+	if (ret < 0)
+		return(ret);
+
+	return(0);
+}
