+static int ad903x_set_chip_config(struct ad903x *ad903x, struct v4l2_ctrl *ctrl)
+{
+	int ret, index = 0;
+	unsigned short *reg, *val;
+	int count = 0;   
+
+	reg = (unsigned short *)(ctrl->p_new.p_u16);
+	val = ((unsigned short *)(ctrl->p_new.p_u16 + 1));  
+
+	while (index < ctrl->elems)
+	{
+		if (((*reg >= 0xC000) && (*reg <= 0xC7FF)) ||
+		    ((*reg >= 0x4000) && (*reg <= 0x6FFF)) ||
+		    ((*reg >= 0x7C00) && (*reg <= 0x7FFF))) {
+
+			ret = ad903x_write_reg(ad903x, *reg, val);
+			if (ret < 0) {
+				dev_err(ad903x->dev, "could not write to device register %x\n", *reg);
+				break;
+			} else {
+				count++;
+			}
+		}
+
+		index += 2;
+		reg += 2;
+		val += 2;
+	}
+	dev_info(ad903x->dev, "ad903x_set_chip_config, total successful write count %d\n", count);
+
+	return 0;
+}
+
+static int ad903x_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ad903x *ad903x = container_of(ctrl->handler,
+					     struct ad903x, ctrls);
+	int ret;
+	u16 val;
+
+	dev_info (ad903x->dev,">> ad903x_s_ctrl\n");
+
+	switch (ctrl->id) {
+	case V4L2_CID_AD_DEV_SET_CHIP_CONFIG_QUERY:
+		dev_info (ad903x->dev,"ad903x_s_ctrl > V4L2_CID_AD_DEV_SET_CHIP_CONFIG_QUERY\n");
+    		ret = ad903x_set_chip_config(ad903x, ctrl);
+		break; 
+
+	case V4L2_CID_AD_DEV_REG_READ_QUERY:
+		dev_info (ad903x->dev,"ad903x_s_ctrl > V4L2_CID_AD_DEV_REG_READ_QUERY\n");
+    		ret = ad903x_read_reg(ad903x, *(u16*)(ctrl->p_new.p_u16), &val);
+		*(u16*)(ctrl->p_new.p_u16) = val;
+		break;	
+
+	default:
+		dev_dbg(ad903x->dev, "ad903x_s_ctrl > Unhandled: %x  param=%x\n", ctrl->id,ctrl->val);
+		ret = -EINVAL;
+		break;
+	}
+
+	dev_info (ad903x->dev,"<< ad903x_s_ctrl\n");
+
+	return ret;
+}
