+static bool spi_imx_diag_selected(struct spi_device *spi)
+{
+	return READ_ONCE(diag_bus) == spi->master->bus_num &&
+	       READ_ONCE(diag_cs) == (int)spi->chip_select;
+}
+
+static void spi_imx_diag_start(struct spi_imx_data *imx, u64 now)
+{
+	struct spi_imx_diag *d = &imx->diag;
+	unsigned int epoch = READ_ONCE(diag_epoch);
+
+	if (!d->start_ns || d->epoch != epoch) {
+		memset(d, 0, sizeof(*d));
+		d->epoch = epoch;
+		d->start_ns = now;
+		d->report_ns = now;
+	}
+}
+
+static void spi_imx_diag_report(struct spi_device *spi, u64 now)
+{
+	struct spi_imx_data *imx = spi_master_get_devdata(spi->master);
+	struct spi_imx_diag *d = &imx->diag;
+	u64 wall_ms;
+
+	/* Cumulative counters, at most one two-line report per second. */
+	if (now - d->report_ns < NSEC_PER_SEC)
+		return;
+	d->report_ns = now;
+	wall_ms = div_u64(now - d->start_ns, NSEC_PER_MSEC);
+	dev_info(imx->dev,
+		 "spi-diag bus=%d cs=%u epoch=%u wall_ms=%llu n=%llu dma_n=%llu pio_n=%llu errors=%llu bytes=%llu setup_us=%llu xfer_us=%llu dma_us=%llu pio_us=%llu payload_n=%llu payload_dma_n=%llu payload_pio_n=%llu payload_bytes=%llu payload_us=%llu ideal_payload_us=%llu payload_gap_us=%llu payload_gap_max_us=%llu\n",
+		 spi->master->bus_num, spi->chip_select, d->epoch, wall_ms,
+		 d->transfers, d->dma_n, d->pio_n, d->errors, d->bytes,
+		 div_u64(d->setup_ns, 1000), div_u64(d->xfer_ns, 1000),
+		 div_u64(d->dma_ns, 1000), div_u64(d->pio_ns, 1000),
+		 d->payload_n, d->payload_dma_n, d->payload_pio_n,
+		 d->payload_bytes, div_u64(d->payload_ns, 1000),
+		 div_u64(d->ideal_payload_ns, 1000),
+		 div_u64(d->payload_gap_ns, 1000),
+		 div_u64(d->payload_gap_max_ns, 1000));
+	dev_info(imx->dev,
+		 "spi-diag-detail bus=%d cs=%u epoch=%u wall_ms=%llu source_hz=%lu req_min=%u req_max=%u clk_min=%u clk_max=%u bpw=%u burst_bits=%u len_min=%u len_max=%u wml_min=%u wml_max=%u tx_sg_max=%u rx_sg_max=%u dma_prepare_us=%llu tx_wait_us=%llu rx_wait_us=%llu dma_tx_chan=%u dma_rx_chan=%u\n",
+		 spi->master->bus_num, spi->chip_select, d->epoch, wall_ms,
+		 imx->spi_clk, d->req_min, d->req_max, d->clk_min, d->clk_max,
+		 d->last_bpw, d->last_burst_bits, d->len_min, d->len_max,
+		 d->wml_min, d->wml_max, d->tx_sg_max, d->rx_sg_max,
+		 div_u64(d->dma_prepare_ns, 1000), div_u64(d->tx_wait_ns, 1000),
+		 div_u64(d->rx_wait_ns, 1000),
+		 !!spi->master->dma_tx, !!spi->master->dma_rx);
+}
